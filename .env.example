# Names only. Never commit real values. Cloud values live in Dokploy.
PMS_MODE=hub
# Development and staging only: create the demo property and demo staff on boot.
PMS_SEED_DEMO=
# Development and staging only: password for the demo staff accounts (generated secret in Dokploy).
PMS_DEMO_PASSWORD=
DATABASE_URL=postgres://pms:pms@localhost:5432/pms_hub_dev
APP_URL=http://localhost:3000
SESSION_SECRET=
CLOUD_SYNC_URL=
# Cloud: key a hub must give to enroll. Hub (staging only): the same key, to enroll on boot.
CLOUD_ENROLL_KEY=
HUB_NAME=
# Hub: require paired devices (the Windows hub service sets 1). Staging leaves it empty.
PMS_REQUIRE_PAIRING=
# Hub: set 0 when the separate worker (pnpm worker:hub) runs the sync loop.
PMS_SYNC_IN_PROCESS=
# Staging only: key for the QA connector at /api/qa/mcp/<key>.
PMS_QA_KEY=
HUB_SALES_GUARD_MINUTES=10
SENTIRE_ACCOUNT_URL=
SENTIRE_ACCOUNT_CLIENT_ID=
SENTIRE_ACCOUNT_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
POSTAL_URL=
POSTAL_API_KEY=
MAIL_FROM=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=
SENTRY_DSN=
