{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentire PMS",
  "version": "0.1.0",
  "identifier": "solutions.sentire.pms",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "title": "Sentire PMS",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sentire Solutions",
    "category": "Business",
    "shortDescription": "Hotel property management",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  }
}
