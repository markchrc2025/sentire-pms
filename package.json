{
  "name": "sentire-pms",
  "private": true,
  "description": "Sentire PMS: installed, offline-capable hotel property management system with a property hub and Sentire Cloud.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:hub": "pnpm --filter @sentire-pms/web dev:hub",
    "dev:cloud": "pnpm --filter @sentire-pms/web dev:cloud",
    "build": "pnpm --filter @sentire-pms/web build",
    "db:generate": "pnpm --filter @sentire-pms/db generate",
    "db:migrate": "pnpm --filter @sentire-pms/db migrate",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
